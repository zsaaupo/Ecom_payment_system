# Copy this file to .env and fill in real values.
# See README.md "Environment configuration" for details on each variable.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
# Directory for db.sqlite3. Leave blank for the project root (local dev).
# In Docker this is set to /app/data so the DB lives on a persistent volume.
DJANGO_DB_DIR=

# CORS - allow the Vercel-hosted frontend to call this backend over ngrok
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=http://localhost:8080
# Existing catalog prices are USD. bKash is available only for BDT-priced orders.
# Changing this setting does NOT convert catalog prices; reprice the catalog first.
STORE_CURRENCY=USD

# Category tree cache (see settings.py). Leave blank to use Django's
# built-in local-memory cache (zero setup). Set to switch to Redis, e.g.
# redis://127.0.0.1:6379/1
REDIS_URL=
CATEGORY_TREE_CACHE_TTL=3600

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- bKash Tokenized Checkout (sandbox) ---
# Sandbox credentials: https://developer.bka.sh/docs/sandbox-checkout
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:8000/api/payments/webhooks/bkash/
